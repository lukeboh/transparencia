{
  "name": "transparencia",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Ferramentas de transparência de órgãos públicos brasileiros — módulo inicial: ranking de responsáveis (fiscais/gestores) pelos maiores valores consolidados de contratos do TSE.",
  "scripts": {
    "tse:discover": "node src/tse/discover.js",
    "tse:scrape": "node src/tse/scrapeContratos.js",
    "tse:scrape-agentes": "node src/tse/scrapeAgentesPublicos.js",
    "tse:scrape-funcoes": "node src/tse/scrapeFuncoes.js",
    "tse:scrape-teletrabalho": "node src/tse/scrapeTeletrabalho.js",
    "tse:scrape-unidades": "node src/tse/scrapeUnidades.js",
    "tse:scrape-terceirizados": "node src/tse/scrapeTerceirizados.js",
    "tse:scrape-horas-extras": "node src/tse/scrapeHorasExtras.js",
    "tse:rank": "node src/tse/cli.js",
    "tse:cruzar-siac": "node src/tse/cruzarSiac.js",
    "data": "node src/tse/buildDashboardData.js",
    "start": "node src/tse/scrapeAgentesPublicos.js && node src/tse/buildDashboardData.js && npm run dev --prefix web",
    "test": "node --test"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.56.1"
  }
}
